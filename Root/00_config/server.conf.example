# 训练服务器连接配置（模板）
# 使用方式: 复制为 server.conf 并填写真实信息
#   cp server.conf.example server.conf
# 注意: server.conf 是本地配置，已被 .gitignore 忽略，不要提交到 git

[server]
# 服务器 IP（必填）
host =

# SSH 用户名
user = root

# SSH 密码（留空则运行时交互输入；填写后脚本可非交互运行）
password =

# SSH 端口
port = 22

# 服务器上训练任务根目录（用于自动定位日志和结果）
task_root = /root/bash/rv1106-ultralytics/data/dataset
